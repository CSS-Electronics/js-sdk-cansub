{
  "name": "@csselectronics/can-types",
  "version": "0.1.0",
  "description": "Shared CAN data types, J1939 helpers and formatters for CANsub apps.",
  "keywords": [
    "cansub",
    "can-bus",
    "can-fd",
    "css-electronics",
    "j1939",
    "types"
  ],
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-package.mjs ."
  },
  "dependencies": {
    "@csselectronics/websocket-client": "^0.1.0",
    "@preact/signals-core": "^1.12.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
